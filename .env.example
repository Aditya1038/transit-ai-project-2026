# TransitAI Environment Configuration Example

# Backend Database
DATABASE_URL=sqlite:///./transit.db

# Backend Security & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_API_KEY=transit-admin-dev-key

# Frontend Environment Variables (in frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CITY_NAME=Hubli-Dharwad
NEXT_PUBLIC_MAP_CENTER_LAT=15.4050
NEXT_PUBLIC_MAP_CENTER_LNG=75.0650
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark
